{
	"name": "@alexandernygard/components-svelte",
	"version": "0.2.0",
	"description": "Alex Nygård's Svelte component library: shadcn-svelte + Bits UI + Tailwind 4, with the same theme as @alexandernygard/components.",
	"type": "module",
	"license": "MIT",
	"author": "Alexander Nygård",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alexandernygard/components.git",
		"directory": "packages/svelte"
	},
	"scripts": {
		"dev": "storybook dev -p 6007",
		"storybook": "storybook dev -p 6007",
		"build-storybook": "storybook build",
		"build": "svelte-kit sync && svelte-package && node scripts/build-css.mjs && publint",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"prepublishOnly": "pnpm typecheck && pnpm build"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"README.md"
	],
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./theme.css": "./dist/styles/theme.css",
		"./styles.css": "./dist/styles.css",
		"./package.json": "./package.json",
		"./*": {
			"types": "./dist/components/ui/*/index.d.ts",
			"svelte": "./dist/components/ui/*/index.js",
			"default": "./dist/components/ui/*/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@storybook/addon-a11y": "^10.6.2",
		"@storybook/addon-docs": "^10.6.2",
		"@storybook/addon-svelte-csf": "^5.1.5",
		"@storybook/addon-themes": "^10.6.2",
		"@storybook/svelte-vite": "^10.6.2",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/cli": "^4.3.3",
		"@tailwindcss/vite": "^4.3.0",
		"publint": "^0.3.21",
		"storybook": "^10.6.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"components",
		"shadcn-svelte",
		"bits-ui",
		"tailwind",
		"ui"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@alexandernygard/tokens": "workspace:^",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.59.0",
		"@shadcn-svelte/primitives": "^0.0.1",
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"embla-carousel-svelte": "^8.6.0",
		"layerchart": "^2.0.0",
		"marked": "^18.1.1",
		"paneforge": "^1.0.2",
		"shiki": "^3.20.0",
		"svelte-sonner": "^1.2.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.0",
		"tw-animate-css": "^1.4.0",
		"vaul-svelte": "^1.0.0-next.7"
	},
	"svelte": "./dist/index.js"
}
